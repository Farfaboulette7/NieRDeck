{
  "name": "NieRDeck",
  "version": "0.0.1",
  "description": "Thème UI inspiré de NieR:Automata pour Steam Deck (Decky Loader)",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["decky", "plugin", "steam-deck", "nier", "theme"],
  "author": "Votre Nom",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.10.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
